# Local-only generated files
**/*.local

# ...except the shared tmux override file, whose name ends in .local only
# because gpakosz/.tmux looks for it under that name. It is shared config.
!tmux-local/.tmux.conf.local

# The local tier: machine-specific settings that must never reach a commit.
# The directories themselves are tracked through their .gitkeep so that `stow`
# links them on a fresh clone, but nothing dropped inside them is.
bash-omb/.config/shell/local/*
!bash-omb/.config/shell/local/.gitkeep
tmux-local/.config/tmux/local/*
!tmux-local/.config/tmux/local/.gitkeep
# Templates are shared; only what you copy from them stays local.
!tmux-local/.config/tmux/local/*.example

# Harness scratch: trial Neovim configs pull in plugins, and the fixture repo
# is regenerated on demand.
# The fixture holds a git repository of its own, so it cannot be committed as
# plain files. tools/nvim-harness/make-fixture.sh generates it instead, which
# is what makes the two gates that default to it work on a fresh clone.
tools/nvim-harness/fixture/
tools/nvim-harness/trials/*/lazy-lock.json
__pycache__/
*.py[co]
tools/nvim-harness/.venv/

# The design canvas is seeded from the .dc.html sources next to it, and the
# seeded file carries a whole editor inlined: 2.4MB of minified code that is
# regenerated rather than edited.
tools/nvim-harness/design/*.html
!tools/nvim-harness/design/*.dc.html

# Harness captures. The tour and the drive script write under $TMPDIR by
# default, but both take -o, and pointing one at the repo should not commit a
# few hundred screenshots.
*.ansi
tools/nvim-harness/captures/
tools/nvim-harness/*-tour/
tools/nvim-harness/*-check/

# Editor and OS leavings, which have no business in a repository that is
# symlinked into $HOME.
*.swp
*.swo
*~
.DS_Store

# Git worktrees for in-progress submodule branches (the LazyVim migration).
.worktrees/

# Built by tools/nvim-harness/make-debug-fixtures.sh: compiled binaries, a
# virtualenv and a cargo target directory, none of which belong in git.
tools/nvim-harness/debug-fixtures/
